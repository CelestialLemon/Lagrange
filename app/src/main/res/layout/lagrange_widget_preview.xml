<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for the Lagrange widget (the live widget is drawn by Glance). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="42m"
        android:textColor="@android:color/system_neutral1_900"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ProgressBar
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="70" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="On track · 18m left"
        android:textColor="@android:color/system_accent1_600"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Phone-free since 14:05"
        android:textColor="@android:color/system_neutral2_700"
        android:textSize="12sp" />
</LinearLayout>
