<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Strictly local: there is deliberately NO android.permission.INTERNET in this manifest. -->
    <!-- WorkManager merges this in for network constraints, which Lagrange never uses. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Already merged in by WorkManager; declared so the boot refresh below never depends on a library. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Nothing goes to cloud backup or device-to-device transfer: see data_extraction_rules and backup_rules.
         Backups are files the user saves (manually or weekly) into a folder they choose. -->
    <application
        android:name=".LagrangeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lagrange"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notifications.LagrangeNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Real-time foreground detection and service-owned TYPE_ACCESSIBILITY_OVERLAY cards (no SYSTEM_ALERT_WINDOW).
             Declares canRetrieveWindowContent="false" and isAccessibilityTool="false" honestly in XML metadata. -->
        <service
            android:name=".friction.LagrangeAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lagrange_accessibility_service" />
        </service>

        <!-- Both broadcasts are exempt from the implicit-broadcast limits, so manifest receivers still get them.
             They are protected broadcasts sent by the system, which reaches non-exported receivers; no other app can. -->
        <receiver
            android:name=".harvest.TimezoneChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget (Jetpack Glance). Exported only for the launcher's APPWIDGET_UPDATE broadcasts. -->
        <receiver
            android:name=".widget.LagrangeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lagrange_widget_info" />
        </receiver>

        <!-- Quick Settings "Focus Boost" tile; only System UI (holding BIND_QUICK_SETTINGS_TILE) can bind it. -->
        <service
            android:name=".tile.FocusBoostTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus_boost"
            android:label="@string/tile_focus_boost_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- After a reboot the monotonic boost/snooze clocks restart: redraw the widget and tile. System-only broadcasts. -->
        <receiver
            android:name=".widget.BootRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".harvest.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
